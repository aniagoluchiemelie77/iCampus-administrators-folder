# iCampus backend, e.g. https://api.example.com/
EXPO_PUBLIC_BACKEND_URL=

# Only public values belong here: everything EXPO_PUBLIC_* ships in the web bundle.
# Attachment uploads are signed by the backend (no Cloudinary keys needed).

# Optional: main iCampus web app, for opening posts, profiles and transactions
# (defaults to https://useicampus.io)
EXPO_PUBLIC_APP_URL=
